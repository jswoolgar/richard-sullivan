---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CallToAction from '../components/CallToAction.astro';
import { partners } from '../data/site';
---

<Base title="Trusted Network" description="Licensed trades Richard works with directly, including David Lawrence for HVAC.">
  <PageHeader
    eyebrow="Trusted network"
    title="One call, the right trades"
    lede="Some jobs need a licensed specialist. I work with people I know and vouch for, and I can manage the job from start to finish."
  />

  <section class="section">
    <div class="wrap">
      <div class="partners partners-lg">
        {partners.map((p) => (
          <div class="partner">
            <span class="partner-trade">{p.trade}</span>
            <h3>{p.name}</h3>
            <span>{p.detail}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <h2>Contractor management</h2>
        <p class="section-lede">Bigger projects often need several trades in the right order.</p>
      </div>
      <ul class="tick-list tick-dark">
        <li>I find and vet the right people for the job</li>
        <li>Schedule them in a sensible order</li>
        <li>Be on site so you don't have to take time off</li>
        <li>Check the work and keep you updated</li>
      </ul>
    </div>
  </section>

  <CallToAction />
</Base>
