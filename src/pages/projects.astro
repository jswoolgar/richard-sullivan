---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CallToAction from '../components/CallToAction.astro';
import { projects } from '../data/projects';
---

<Base title="Projects" description="A selection of recent repair, painting, masonry, fencing and historic home projects.">
  <PageHeader eyebrow="Projects" title="Recent work" lede="A sample of the jobs I've done for homeowners around the area." />

  <section class="section">
    <div class="wrap">
      <div class="projects">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <CallToAction />
</Base>
