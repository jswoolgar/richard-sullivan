---
import { site, nav, tel } from '../data/site';
---

<footer class="footer">
  <div class="wrap footer-inner">
    <div>
      <strong class="brand">{site.name}</strong>
      <p>{site.tagline}</p>
      <p><a href={`tel:${tel}`}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
    <nav class="footer-nav">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/contact/">Contact</a>
    </nav>
  </div>
  <div class="wrap footer-legal">© {new Date().getFullYear()} {site.name}</div>
</footer>
