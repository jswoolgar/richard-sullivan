---
import { site } from '../data/site';
import { menu } from '../data/menu';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="topbar">
  <div class="wrap topbar-inner">
    <a href="/" class="brand">{site.name}<span class="brand-sub">Handyman</span></a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav id="site-nav">
      {menu.map((item, i) =>
        item.items?.length ? (
          <div class="has-dropdown">
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            <button class="sub-toggle" aria-expanded="false" aria-label={`Show ${item.label} links`}>▾</button>
            <div class:list={['dropdown', { 'dropdown-right': i >= menu.length - 2 }]}>
              {item.items.map((child) => (
                <a href={child.href}>
                  <strong>{child.label}</strong>
                  {child.desc && <span>{child.desc}</span>}
                </a>
              ))}
              {item.all && <a href={item.href} class="dropdown-all">{item.all} →</a>}
            </div>
          </div>
        ) : (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        )
      )}
      <a href="/contact/" class="btn btn-small">Contact</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const navEl = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    navEl?.classList.toggle('open', !open);
  });

  // Expand or collapse a section's links in the mobile menu.
  navEl?.querySelectorAll<HTMLButtonElement>('.sub-toggle').forEach((btn) =>
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.parentElement?.classList.toggle('expanded', !expanded);
    })
  );

  // Close the menus after picking a link on the same page.
  navEl?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      a.blur();
      navEl.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
    })
  );
</script>
